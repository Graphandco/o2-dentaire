{
   "name": "frontend",
   "version": "0.1.0",
   "private": true,
   "scripts": {
      "dev": "next dev --turbopack",
      "build": "next build",
      "start": "next start",
      "lint": "next lint",
      "dev:docker": "concurrently -k \"PORT=3003 node --watch server.js\" \"npx wait-on -t 10000 http://localhost:3003 && npx browser-sync start -c bs-config.docker.js\"",
      "docker:build": "docker compose -f docker-compose.yml build",
      "docker:push": "docker compose -f docker-compose.yml push",
      "docker:deploy": "docker compose -f docker-compose.yml build && docker compose -f docker-compose.yml push"
   },
   "dependencies": {
      "@radix-ui/react-slot": "^1.2.3",
      "@tailwindcss/postcss": "^4.1.7",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "framer-motion": "^12.15.0",
      "lucide-react": "^0.511.0",
      "marked": "^15.0.12",
      "next": "16.0.10",
      "postcss": "^8.5.3",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "react-photoswipe-gallery": "^3.1.1",
      "tailwind-merge": "^3.3.0",
      "tailwindcss": "^4.1.7"
   },
   "devDependencies": {
      "@tailwindcss/typography": "^0.5.16",
      "tw-animate-css": "^1.3.0"
   }
}
